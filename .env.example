# Server Environment Mode
NODE_ENV=

# System Administrator Email (Google Account for System Admin Sign-in)
ADMIN_EMAIL=

# Google OAuth 2.0 Web Client ID (from Google Cloud Console)
GOOGLE_CLIENT_ID=

# JSON Web Token Secret Key (Required in production)
JWT_SECRET=

# Persistent Data Storage Directory (e.g., /var/data for Render Persistent Disk)
DATA_DIR=

# SMTP Mail Server Configuration (Nodemailer)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Emergency Reset Flag for System Admin 2FA (Set to true to clear TOTP enrollment on startup)
RESET_ADMIN_2FA=
